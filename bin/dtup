#! /usr/bin/python

def print_cheat_sheet():
    print('Info from https://wiki.gentoo.org/wiki/Gentoo_Cheat_Sheet')
    print()
    print('   Run commands as root:')
    print('emerge-webrsync')
    print('emerge --sync')
    print('   To see all changes:')
    print('emerge --ask --verbose --update --newuse --deep @world')
    print('   To perform suucint upgrade: ')
    print('emerge --quiet --update --newuse --deep @world')
    print('   To clean up:')
    print('perl-cleaner --all')
    print('haskell-updater')
    print('   Pretend deepclean before execute')
    print('emerge --pretend --depclean')
    print('emerge --quiet --depclean')
    print('   To check/ update config files:')
    print('dispatch-conf')

    return

print_cheat_sheet()
