#! /bin/bash

# If Virt Manager can't connect to libvirtd service, follow the instructions found here:
# https://wiki.gentoo.org/wiki/Virt-manager
#
# That is:
# * Edit /etc/libvirt/libvirtd.conf
# * Add (or uncomment there) these lines:
#auth_unix_ro = "none"
#auth_unix_rw = "none"
#unix_sock_group = "libvirt"
#unix_sock_ro_perms = "0777"
#unix_sock_rw_perms = "0770"
# * run dtvm again, and should work

# Need doas (or sudo) to start libvirtd
# To skip doas password, change doas config file
# permit my_user cmd /etc/init.d/libvirtd args restart
service=/etc/init.d/libvirtd
args=restart

doas $service $args
virt-manager
